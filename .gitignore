/_output/
/.quarto/
*.html
**/*.quarto_ipynb

# Source images are tracked. Rendered output lives only under /_output/ (ignored above);
# a blanket *.png rule here once left a deck's hero photo out of the repo (2026-09-13).

# vendored extension sources + skin head files are SOURCE, not rendered output
!**/_extensions/**
!**/*-skin.html
!**/local-style.html
!relationsec/*.html

/node_modules/
*.pdf

# poll ids written by strawpoll.ts rotate; the id is the join secret of a link-only poll
**/polls.local.json
